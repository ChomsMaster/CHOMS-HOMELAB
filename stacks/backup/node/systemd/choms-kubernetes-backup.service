[Unit]
Description=CHOMS Kubernetes Runtime and Database Backup
After=network-online.target k3s.service
Wants=network-online.target
Requires=k3s.service

[Service]
Type=oneshot
User=chomsmaster
Group=chomsmaster
ExecStart=/usr/local/sbin/choms-kubernetes-backup.sh
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7

[Install]
WantedBy=multi-user.target
