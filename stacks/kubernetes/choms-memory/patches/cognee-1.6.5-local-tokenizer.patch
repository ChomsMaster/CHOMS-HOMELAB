+def _local_snapshot(model: str) -> Path | None:
+    path = Path(model)
+    if not path.is_absolute():
+        return None
+    if path.resolve(strict=True) != path or not path.is_dir():
+        raise ValueError("Tokenizer snapshot must be a real local directory")
+    if any(child.is_symlink() for child in path.iterdir()):
+        raise ValueError("Tokenizer snapshot symlinks are forbidden")
+    for name in ("tokenizer.json", "tokenizer_config.json"):
+        if not (path / name).is_file():
+            raise FileNotFoundError("Required local tokenizer metadata is missing")
+    return path
 
 
