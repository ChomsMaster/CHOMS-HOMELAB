[Unit]
Description=CHOMS external monitor read-only host status helper
After=default.target

[Service]
Type=simple
ExecStart=/home/chomsmaster/choms-external-monitor/host-status.sh
Restart=always
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/chomsmaster/choms-external-monitor/host-status

[Install]
WantedBy=default.target
